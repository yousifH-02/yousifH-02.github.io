---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout title="Snake" category="Arcade / 01" description="A classic, stripped back. Find your rhythm, fill the board, and try not to get in your own way.">
<div class="workspace"><section class="panel snake-panel"><div class="stat-row"><div><span>Score</span><strong id="score">0</strong></div><div><span>Best at this pace</span><strong id="high-score">0</strong></div><div><span>Speed</span><strong id="speed">1×</strong></div></div><div class="board"><canvas id="game" width="480" height="480" aria-label="Snake game board. Use arrow keys, WASD, or the direction buttons." tabindex="0"></canvas><div id="overlay" class="board-overlay"><span class="eyebrow" id="overlay-label">ONE MORE ROUND?</span><h2 id="overlay-title">Stay hungry.</h2><p id="overlay-copy">Press Play to begin.</p><button id="play" class="button primary">Play Snake →</button></div></div><div class="toolbar"><button class="button" id="pause" disabled>Pause</button><button class="button" id="restart">Restart</button><label for="difficulty" class="sr-only">Difficulty</label><select id="difficulty"><option value="chill">Chill</option><option value="classic" selected>Classic</option><option value="fast">Fast</option></select></div><div class="dpad" aria-label="Direction controls"><button data-direction="up" aria-label="Move up">↑</button><button data-direction="left" aria-label="Move left">←</button><button data-direction="down" aria-label="Move down">↓</button><button data-direction="right" aria-label="Move right">→</button></div><p id="game-status" class="status-message" role="status">Choose a pace and press Play.</p></section><aside class="panel"><span class="pill">No installs. Just play.</span><h2 class="panel-title" style="margin-top:26px">Simple rules.<br/>Very real consequences.</h2><ol class="help-list"><li>Eat the bright squares to grow.</li><li>Avoid the walls and your own tail.</li><li>Each bite makes the game a little faster.</li></ol><hr class="rule"/><h2 class="panel-title">Take control</h2><p class="panel-note"><span class="key">↑ ↓ ← →</span> or <span class="key">W A S D</span> to steer.<br/><br/><span class="key">Space</span> to pause or resume.<br/><br/>On a phone, swipe the board or use the direction buttons.</p><hr class="rule"/><p class="panel-note">Best scores are saved on this device, separately for each pace. Leaving the tab automatically pauses the game.</p></aside></div>
</AppLayout>
<script src="../../../scripts/snake.js"></script>
<style>.snake-panel{padding:20px}.snake-panel .stat-row{margin-bottom:18px}.board{position:relative;width:100%;max-width:480px;margin:auto;aspect-ratio:1;border:1px solid #57333f;border-radius:9px;overflow:hidden}canvas{display:block;width:100%;height:100%;touch-action:none}.board-overlay{position:absolute;inset:0;background:#120e14de;backdrop-filter:blur(5px);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center}.board-overlay h2{font-size:46px;margin:10px 0;letter-spacing:-.05em}.board-overlay p{color:var(--muted);font-size:14px;margin-bottom:25px}.dpad{display:grid;grid-template-columns:repeat(3,48px);gap:7px;justify-content:center;margin-top:24px}.dpad button{height:44px;border:1px solid #65404d;border-radius:8px;background:#241820;color:#f3bdcc;font-size:20px!important;touch-action:manipulation}.dpad button:first-child{grid-column:2}.dpad button:nth-child(2){grid-column:1}.dpad button:active{background:#613143}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:400px){.snake-panel{padding:12px}.board-overlay h2{font-size:34px}.toolbar{gap:8px}.toolbar .button{padding:12px}.toolbar select{font-size:13px}}</style>
