---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Snake — Yousif Husni</title>

  <style>
    :root {
      --bg: #080808;
      --surface: #101010;
      --surface2: #151515;
      --text: #f2f0eb;
      --muted: #8f8f8b;
      --line: #292929;
      --red: #d84b4b;
      --red-bright: #ee6262;
      --max: 1180px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    ::selection {
      background: var(--red);
      color: white;
    }

    /* NAV */

    .nav {
      height: 70px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
    }

    .nav-inner {
      width: min(calc(100% - 48px), var(--max));
      margin: auto;

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-size: 15px;
      font-weight: 650;
    }

    .back {
      color: var(--muted);
      font-size: 13px;
      transition: color 0.2s ease;
    }

    .back:hover {
      color: var(--red);
    }

    /* PAGE */

    main {
      width: min(calc(100% - 48px), var(--max));
      margin: auto;
      padding: 65px 0 90px;
    }

    .eyebrow {
      color: var(--red);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.17em;
    }

    h1 {
      margin: 15px 0 20px;

      font-size: clamp(75px, 12vw, 150px);
      font-weight: 550;

      line-height: 0.82;
      letter-spacing: -0.075em;
    }

    .intro {
      margin: 0;
      max-width: 650px;

      color: #aaa;

      font-size: 16px;
      line-height: 1.7;
    }

    /* GAME */

    .game-layout {
      margin-top: 60px;

      display: grid;
      grid-template-columns: minmax(0, 1fr) 240px;

      gap: 35px;
      align-items: start;
    }

    .game-shell {
      padding: 17px;

      border: 1px solid var(--line);
      background: var(--surface);
    }

    .game-container {
      position: relative;

      width: 100%;
      aspect-ratio: 1;

      background: #0b0b0b;
      overflow: hidden;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* OVERLAY */

    .overlay {
      position: absolute;
      inset: 0;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      padding: 30px;

      text-align: center;

      background: rgba(8, 8, 8, 0.84);
      backdrop-filter: blur(5px);

      transition: opacity 0.2s ease;
    }

    .overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .overlay-small {
      color: var(--red);

      font-size: 10px;

      text-transform: uppercase;
      letter-spacing: 0.18em;
    }

    .overlay h2 {
      margin: 12px 0 8px;

      font-size: clamp(36px, 6vw, 68px);
      font-weight: 500;

      letter-spacing: -0.055em;
    }

    .overlay p {
      margin: 0 0 25px;

      color: var(--muted);

      font-size: 13px;
    }

    .start-button {
      padding: 12px 21px;

      border: 1px solid var(--red);

      background: var(--red);
      color: white;

      cursor: pointer;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .start-button:hover {
      background: var(--red-bright);
      transform: translateY(-2px);
    }

    /* STATS */

    .sidebar {
      border-top: 1px solid var(--line);
    }

    .stat {
      padding: 22px 0;

      border-bottom: 1px solid var(--line);
    }

    .stat-label {
      color: var(--muted);

      font-size: 10px;

      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .stat-value {
      margin-top: 7px;

      font-size: 35px;

      letter-spacing: -0.04em;
    }

    .instructions {
      padding: 23px 0;

      border-bottom: 1px solid var(--line);
    }

    .instructions h3 {
      margin: 0 0 13px;

      color: var(--red);

      font-size: 10px;
      font-weight: 500;

      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .instructions p {
      margin: 0;

      color: #aaa;

      font-size: 13px;
      line-height: 1.9;
    }

    .buttons {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 8px;

      margin-top: 20px;
    }

    .buttons button {
      padding: 11px 7px;

      border: 1px solid var(--line);

      background: var(--surface2);
      color: var(--text);

      cursor: pointer;

      transition:
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .buttons button:hover {
      border-color: var(--red);
      color: var(--red-bright);
    }

    /* MOBILE CONTROLS */

    .mobile-controls {
      display: none;

      width: 190px;

      margin: 28px auto 0;

      grid-template-columns: repeat(3, 1fr);

      gap: 7px;
    }

    .mobile-controls button {
      aspect-ratio: 1;

      border: 1px solid var(--line);

      background: var(--surface2);
      color: white;

      font-size: 20px;

      touch-action: manipulation;
    }

    .up {
      grid-column: 2;
    }

    .left {
      grid-column: 1;
      grid-row: 2;
    }

    .down {
      grid-column: 2;
      grid-row: 2;
    }

    .right {
      grid-column: 3;
      grid-row: 2;
    }

    footer {
      margin-top: 70px;

      padding-top: 22px;

      border-top: 1px solid var(--line);

      display: flex;
      justify-content: space-between;

      color: var(--muted);

      font-size: 10px;

      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    @media (max-width: 820px) {

      .nav-inner,
      main {
        width: calc(100% - 32px);
      }

      .game-layout {
        grid-template-columns: 1fr;
      }

      .sidebar {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 0 25px;
      }

      .instructions,
      .buttons {
        grid-column: 1 / -1;
      }

      .mobile-controls {
        display: grid;
      }
    }
  </style>
</head>

<body>

  <nav class="nav">

    <div class="nav-inner">

      <a href="/" class="brand">
        Yousif Husni
      </a>

      <a href="/apps/" class="back">
        ← Back to Apps
      </a>

    </div>

  </nav>

  <main>

    <div class="eyebrow">
      App / Game
    </div>

    <h1>
      Snake.
    </h1>

    <p class="intro">
      The classic Snake game rebuilt for the browser.
      Eat, grow, move faster, and try to beat your high score.
    </p>

    <section class="game-layout">

      <div>

        <div class="game-shell">

          <div class="game-container">

            <canvas
              id="game"
              width="600"
              height="600"
            ></canvas>

            <div
              class="overlay"
              id="overlay"
            >

              <div
                class="overlay-small"
                id="overlayLabel"
              >
                Ready?
              </div>

              <h2 id="overlayTitle">
                Play Snake
              </h2>

              <p id="overlayText">
                Use the arrow keys or WASD.
              </p>

              <button
                class="start-button"
                id="startButton"
              >
                Start Game →
              </button>

            </div>

          </div>

        </div>

        <div class="mobile-controls">

          <button
            class="up"
            data-direction="up"
          >
            ↑
          </button>

          <button
            class="left"
            data-direction="left"
          >
            ←
          </button>

          <button
            class="down"
            data-direction="down"
          >
            ↓
          </button>

          <button
            class="right"
            data-direction="right"
          >
            →
          </button>

        </div>

      </div>

      <aside class="sidebar">

        <div class="stat">

          <div class="stat-label">
            Score
          </div>

          <div
            class="stat-value"
            id="score"
          >
            0
          </div>

        </div>

        <div class="stat">

          <div class="stat-label">
            High Score
          </div>

          <div
            class="stat-value"
            id="highScore"
          >
            0
          </div>

        </div>

        <div class="stat">

          <div class="stat-label">
            Speed
          </div>

          <div
            class="stat-value"
            id="speed"
          >
            1×
          </div>

        </div>

        <div class="instructions">

          <h3>
            Controls
          </h3>

          <p>
            Arrow Keys / WASD — Move
            <br />
            Space — Pause
            <br />
            R — Restart
          </p>

        </div>

        <div class="buttons">

          <button id="pauseButton">
            Pause
          </button>

          <button id="restartButton">
            Restart
          </button>

        </div>

      </aside>

    </section>

    <footer>

      <span>
        © 2026 Yousif Husni
      </span>

      <span>
        Browser Experiment
      </span>

    </footer>

  </main>

  <script is:inline>

    const canvas =
      document.getElementById("game");

    const ctx =
      canvas.getContext("2d");

    const scoreDisplay =
      document.getElementById("score");

    const highScoreDisplay =
      document.getElementById("highScore");

    const speedDisplay =
      document.getElementById("speed");

    const overlay =
      document.getElementById("overlay");

    const overlayLabel =
      document.getElementById("overlayLabel");

    const overlayTitle =
      document.getElementById("overlayTitle");

    const overlayText =
      document.getElementById("overlayText");

    const startButton =
      document.getElementById("startButton");

    const pauseButton =
      document.getElementById("pauseButton");

    const restartButton =
      document.getElementById("restartButton");


    const gridSize = 24;

    const cellSize =
      canvas.width / gridSize;


    let snake = [];

    let food = {
      x: 5,
      y: 5
    };

    let direction = {
      x: 1,
      y: 0
    };

    let nextDirection = {
      x: 1,
      y: 0
    };

    let score = 0;

    let running = false;

    let paused = false;

    let gameTimer;

    let gameSpeed = 125;


    let highScore =
      Number(
        localStorage.getItem(
          "yousifSnakeHighScore"
        ) || 0
      );


    highScoreDisplay.textContent =
      highScore;


    function resetGame() {

      snake = [
        { x: 12, y: 12 },
        { x: 11, y: 12 },
        { x: 10, y: 12 }
      ];

      direction = {
        x: 1,
        y: 0
      };

      nextDirection = {
        x: 1,
        y: 0
      };

      score = 0;

      gameSpeed = 125;

      paused = false;

      scoreDisplay.textContent = "0";

      speedDisplay.textContent = "1×";

      pauseButton.textContent =
        "Pause";

      createFood();

      draw();

    }


    function createFood() {

      let valid = false;

      while (!valid) {

        food = {

          x:
            Math.floor(
              Math.random() *
              gridSize
            ),

          y:
            Math.floor(
              Math.random() *
              gridSize
            )

        };

        valid =
          !snake.some(
            part =>
              part.x === food.x &&
              part.y === food.y
          );

      }

    }


    function startGame() {

      clearTimeout(gameTimer);

      resetGame();

      running = true;

      overlay.classList.add(
        "hidden"
      );

      scheduleTick();

    }


    function scheduleTick() {

      clearTimeout(gameTimer);

      if (
        running &&
        !paused
      ) {

        gameTimer =
          setTimeout(
            gameLoop,
            gameSpeed
          );

      }

    }


    function gameLoop() {

      direction =
        nextDirection;


      const head = {

        x:
          snake[0].x +
          direction.x,

        y:
          snake[0].y +
          direction.y

      };


      const hitWall =

        head.x < 0 ||

        head.x >=
          gridSize ||

        head.y < 0 ||

        head.y >=
          gridSize;


      const hitSelf =

        snake.some(
          part =>
            part.x === head.x &&
            part.y === head.y
        );


      if (
        hitWall ||
        hitSelf
      ) {

        gameOver();

        return;

      }


      snake.unshift(
        head
      );


      if (
        head.x === food.x &&
        head.y === food.y
      ) {

        score++;

        scoreDisplay.textContent =
          score;


        if (
          score >
          highScore
        ) {

          highScore =
            score;

          highScoreDisplay
            .textContent =
              highScore;

          localStorage.setItem(
            "yousifSnakeHighScore",
            highScore
          );

        }


        gameSpeed =
          Math.max(
            55,
            125 -
            Math.floor(
              score / 4
            ) * 8
          );


        const multiplier =
          (
            125 /
            gameSpeed
          )
          .toFixed(1)
          .replace(
            ".0",
            ""
          );


        speedDisplay.textContent =
          multiplier + "×";


        createFood();

      }

      else {

        snake.pop();

      }


      draw();

      scheduleTick();

    }


    function draw() {

      ctx.fillStyle =
        "#0b0b0b";

      ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
      );


      /* GRID */

      ctx.strokeStyle =
        "#151515";

      ctx.lineWidth = 1;


      for (
        let i = 1;
        i < gridSize;
        i++
      ) {

        const position =
          i * cellSize;


        ctx.beginPath();

        ctx.moveTo(
          position,
          0
        );

        ctx.lineTo(
          position,
          canvas.height
        );

        ctx.stroke();


        ctx.beginPath();

        ctx.moveTo(
          0,
          position
        );

        ctx.lineTo(
          canvas.width,
          position
        );

        ctx.stroke();

      }


      /* FOOD */

      ctx.fillStyle =
        "#d84b4b";

      ctx.beginPath();

      ctx.arc(

        food.x *
          cellSize +
          cellSize / 2,

        food.y *
          cellSize +
          cellSize / 2,

        cellSize *
          0.28,

        0,

        Math.PI * 2

      );

      ctx.fill();


      /* SNAKE */

      snake.forEach(
        (part, index) => {

          ctx.fillStyle =
            index === 0
              ? "#f2f0eb"
              : "#c7c5bf";


          const inset = 2;


          ctx.fillRect(

            part.x *
              cellSize +
              inset,

            part.y *
              cellSize +
              inset,

            cellSize -
              inset * 2,

            cellSize -
              inset * 2

          );

        }
      );

    }


    function gameOver() {

      running = false;

      clearTimeout(
        gameTimer
      );


      overlayLabel.textContent =
        "Game Over";


      if (
        score ===
          highScore &&
        score > 0
      ) {

        overlayTitle.textContent =
          "New high score.";

      }

      else {

        overlayTitle.textContent =
          "Try again.";

      }


      overlayText.textContent =
        `You scored ${score}.`;


      startButton.textContent =
        "Play Again →";


      overlay.classList.remove(
        "hidden"
      );

    }


    function togglePause() {

      if (!running) {
        return;
      }


      paused =
        !paused;


      pauseButton.textContent =
        paused
          ? "Resume"
          : "Pause";


      if (paused) {

        clearTimeout(
          gameTimer
        );


        overlayLabel.textContent =
          "Paused";

        overlayTitle.textContent =
          "Game paused.";

        overlayText.textContent =
          "Press Space or Resume to continue.";

        startButton.textContent =
          "Resume →";


        overlay.classList.remove(
          "hidden"
        );

      }

      else {

        overlay.classList.add(
          "hidden"
        );

        scheduleTick();

      }

    }


    function changeDirection(
      newDirection
    ) {

      const directions = {

        up: {
          x: 0,
          y: -1
        },

        down: {
          x: 0,
          y: 1
        },

        left: {
          x: -1,
          y: 0
        },

        right: {
          x: 1,
          y: 0
        }

      };


      const chosen =
        directions[
          newDirection
        ];


      if (!chosen) {
        return;
      }


      const reversing =
        chosen.x ===
          -direction.x &&
        chosen.y ===
          -direction.y;


      if (!reversing) {

        nextDirection =
          chosen;

      }

    }


    document.addEventListener(
      "keydown",
      event => {

        const key =
          event.key
            .toLowerCase();


        const controls = {

          arrowup: "up",

          w: "up",

          arrowdown:
            "down",

          s: "down",

          arrowleft:
            "left",

          a: "left",

          arrowright:
            "right",

          d: "right"

        };


        if (
          controls[key]
        ) {

          event.preventDefault();

          changeDirection(
            controls[key]
          );

        }


        else if (
          event.code ===
          "Space"
        ) {

          event.preventDefault();

          togglePause();

        }


        else if (
          key === "r"
        ) {

          startGame();

        }

      }
    );


    document
      .querySelectorAll(
        "[data-direction]"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              changeDirection(
                button.dataset
                  .direction
              );

            }
          );

        }
      );


    startButton.addEventListener(
      "click",
      () => {

        if (
          running &&
          paused
        ) {

          togglePause();

        }

        else {

          startGame();

        }

      }
    );


    pauseButton.addEventListener(
      "click",
      togglePause
    );


    restartButton.addEventListener(
      "click",
      startGame
    );


    resetGame();

  </script>

</body>
</html>