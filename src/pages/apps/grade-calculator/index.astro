---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout title="Grade calculator" category="Student toolkit" description="Know where you stand. Add your grades, set your weights, and plan the score you need next.">
<div class="workspace"><section class="panel"><div class="grade-heading"><h2 class="panel-title">Your course breakdown</h2><span class="pill">Weighted average</span></div><div class="grade-labels" aria-hidden="true"><span>Category</span><span>Grade %</span><span>Weight %</span><span></span></div><div id="grade-rows"></div><div class="toolbar"><button class="button" id="add-category">+ Add category</button><button class="minor-button" id="reset-grades">Reset example</button></div><p class="panel-note">Enter graded categories only. Your current average is normalized over their combined weight.</p><p id="grade-error" class="status-message" role="status"></p></section><aside class="panel"><span class="eyebrow">CURRENT WEIGHTED AVERAGE</span><p class="result-number" id="grade-result">—</p><p class="panel-note" id="weight-summary"></p><hr class="rule"/><h2 class="panel-title">What do I need on the final?</h2><label class="label" for="target-grade">Target course grade (%)</label><input type="number" id="target-grade" min="0" max="100" value="90" step="0.1"/><label class="label" for="final-weight">Final exam weight (%)</label><input type="number" id="final-weight" min="1" max="100" value="30" step="0.1"/><p class="result-number" id="final-result">—</p><p class="status-message" id="final-message" aria-live="polite"></p><p class="panel-note">The current average represents all work outside the final. The final is weighted separately.</p></aside></div>
</AppLayout>
<script src="../../../scripts/grades.js"></script>
<style>.grade-heading{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:25px}.grade-labels{display:grid;grid-template-columns:1.6fr 1fr 1fr 36px;gap:10px;font-size:11px;color:var(--muted);margin-bottom:10px}.grade-heading .pill{font-size:9px;white-space:nowrap}.grade-heading h2{margin:5px 0}:global(.grade-row){display:grid;grid-template-columns:1.6fr 1fr 1fr 36px;gap:10px;margin-bottom:12px}:global(.grade-row input){padding:12px 10px;font-size:14px}:global(.remove-grade){padding:0;border:0;background:transparent;color:#bf8798;font-size:22px!important}:global(.remove-grade:disabled){opacity:.3}@media(max-width:450px){.grade-labels,:global(.grade-row){grid-template-columns:1.2fr 1fr 1fr 24px;gap:6px}.grade-heading{display:block}.grade-heading h2{margin-bottom:14px}:global(.grade-row input){padding:10px 6px;font-size:12px}}</style>
