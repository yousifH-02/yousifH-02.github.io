---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cybersecurity Phishing Detector | Yousif Husni</title>
    <style>
      * {
        box-sizing: border-box;
      }

      :root {
        --bg: #050816;
        --panel: rgba(10, 18, 40, 0.82);
        --panel-strong: rgba(15, 23, 42, 0.94);
        --line: rgba(148, 163, 184, 0.22);
        --text: #f8fafc;
        --muted: #a7b3c7;
        --cyan: #22d3ee;
        --violet: #a78bfa;
        --pink: #fb7185;
        --green: #34d399;
        --yellow: #facc15;
        --red: #fb7185;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at 15% 10%, rgba(34, 211, 238, 0.18), transparent 28%),
          radial-gradient(circle at 80% 0%, rgba(167, 139, 250, 0.18), transparent 30%),
          radial-gradient(circle at 50% 100%, rgba(251, 113, 133, 0.1), transparent 35%),
          linear-gradient(135deg, #020617 0%, #050816 55%, #0f172a 100%);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent 75%);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 18px 60px;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(2, 6, 23, 0.62);
        backdrop-filter: blur(16px);
        box-shadow: 0 18px 70px rgba(0, 0, 0, 0.28);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(34, 211, 238, 0.25), rgba(167, 139, 250, 0.28));
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 0 28px rgba(34, 211, 238, 0.16);
      }

      .brand h1 {
        margin: 0;
        font-size: 17px;
        letter-spacing: 0.2px;
      }

      .back {
        color: var(--cyan);
        font-size: 14px;
      }

      .hero {
        margin-top: 18px;
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: 16px;
      }

      @media (max-width: 880px) {
        .hero {
          grid-template-columns: 1fr;
        }
      }

      .hero-card,
      .radar-card,
      .tool-card,
      .result-card,
      .tips-card {
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 28px;
        backdrop-filter: blur(18px);
        box-shadow: 0 20px 90px rgba(0, 0, 0, 0.28);
      }

      .hero-card {
        padding: clamp(24px, 4vw, 42px);
        overflow: hidden;
        position: relative;
      }

      .hero-card::after {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 999px;
        right: -110px;
        top: -120px;
        background: radial-gradient(circle, rgba(34, 211, 238, 0.28), transparent 66%);
      }

      .eyebrow {
        margin: 0 0 12px;
        color: var(--cyan);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-card h2 {
        position: relative;
        margin: 0 0 14px;
        font-size: clamp(38px, 7vw, 74px);
        line-height: 0.93;
        letter-spacing: -0.055em;
      }

      .hero-card p {
        position: relative;
        margin: 0;
        max-width: 720px;
        color: var(--muted);
        line-height: 1.7;
        font-size: 16px;
      }

      .chips {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 18px;
      }

      .chip {
        border: 1px solid rgba(148, 163, 184, 0.26);
        border-radius: 999px;
        padding: 8px 11px;
        color: #cbd5e1;
        background: rgba(255, 255, 255, 0.045);
        font-size: 12px;
      }

      .radar-card {
        padding: 22px;
        display: grid;
        place-items: center;
      }

      .radar {
        width: min(280px, 78vw);
        aspect-ratio: 1;
        border-radius: 50%;
        border: 1px solid rgba(34, 211, 238, 0.3);
        background:
          radial-gradient(circle, transparent 0 20%, rgba(34, 211, 238, 0.09) 21% 22%, transparent 23% 42%, rgba(34, 211, 238, 0.08) 43% 44%, transparent 45% 64%, rgba(34, 211, 238, 0.08) 65% 66%, transparent 67%),
          conic-gradient(from 80deg, rgba(34, 211, 238, 0.35), rgba(34, 211, 238, 0.02), rgba(167, 139, 250, 0.1), rgba(34, 211, 238, 0.35));
        position: relative;
        box-shadow: inset 0 0 40px rgba(34, 211, 238, 0.1), 0 0 45px rgba(34, 211, 238, 0.1);
      }

      .radar::before,
      .radar::after {
        content: "";
        position: absolute;
        inset: 50% 0 auto 0;
        height: 1px;
        background: rgba(34, 211, 238, 0.35);
      }

      .radar::after {
        transform: rotate(90deg);
      }

      .pulse {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--cyan);
        box-shadow: 0 0 18px var(--cyan);
      }

      .p1 { left: 62%; top: 28%; }
      .p2 { left: 35%; top: 58%; background: var(--pink); box-shadow: 0 0 18px var(--pink); }
      .p3 { left: 70%; top: 66%; background: var(--violet); box-shadow: 0 0 18px var(--violet); }

      .radar-caption {
        width: 100%;
        margin-top: 18px;
        color: var(--muted);
        line-height: 1.55;
        font-size: 14px;
      }

      .main-grid {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 16px;
        align-items: start;
      }

      @media (max-width: 980px) {
        .main-grid {
          grid-template-columns: 1fr;
        }
      }

      .tool-card,
      .result-card,
      .tips-card {
        padding: 20px;
      }

      .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }

      .section-title h3 {
        margin: 0;
        font-size: 20px;
      }

      .mini {
        color: var(--muted);
        font-size: 12px;
      }

      label {
        display: block;
        margin: 14px 0 7px;
        color: #dbeafe;
        font-size: 13px;
        font-weight: 800;
      }

      input,
      textarea {
        width: 100%;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 16px;
        padding: 13px 14px;
        background: rgba(2, 6, 23, 0.72);
        color: var(--text);
        font: inherit;
        outline: none;
      }

      textarea {
        min-height: 220px;
        resize: vertical;
        line-height: 1.55;
      }

      input:focus,
      textarea:focus {
        border-color: rgba(34, 211, 238, 0.7);
        box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.08);
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
      }

      button {
        border: 0;
        border-radius: 999px;
        padding: 12px 15px;
        color: white;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
        background: linear-gradient(135deg, #0891b2, #7c3aed);
        box-shadow: 0 14px 34px rgba(34, 211, 238, 0.12);
      }

      button:hover {
        transform: translateY(-1px);
      }

      .secondary {
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.13);
        box-shadow: none;
      }

      .danger {
        background: rgba(251, 113, 133, 0.14);
        border: 1px solid rgba(251, 113, 133, 0.28);
        box-shadow: none;
      }

      .score-box {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 16px;
        align-items: center;
      }

      @media (max-width: 560px) {
        .score-box {
          grid-template-columns: 1fr;
        }
      }

      .score-ring {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--green) 0deg, rgba(255,255,255,0.08) 0deg);
        position: relative;
      }

      .score-ring::before {
        content: "";
        position: absolute;
        inset: 10px;
        border-radius: 50%;
        background: #07111f;
        border: 1px solid rgba(255,255,255,0.08);
      }

      .score-text {
        position: relative;
        text-align: center;
      }

      .score-text strong {
        display: block;
        font-size: 38px;
        line-height: 1;
      }

      .score-text span {
        color: var(--muted);
        font-size: 12px;
      }

      .risk-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        border-radius: 999px;
        padding: 8px 11px;
        font-weight: 900;
        font-size: 13px;
        background: rgba(52, 211, 153, 0.14);
        color: var(--green);
        border: 1px solid rgba(52, 211, 153, 0.25);
      }

      .summary {
        margin: 12px 0 0;
        color: var(--muted);
        line-height: 1.65;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 16px;
      }

      @media (max-width: 560px) {
        .stats {
          grid-template-columns: 1fr;
        }
      }

      .stat {
        padding: 12px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.045);
        border: 1px solid rgba(255, 255, 255, 0.09);
      }

      .stat strong {
        display: block;
        font-size: 20px;
      }

      .stat span {
        color: var(--muted);
        font-size: 12px;
      }

      .findings {
        margin-top: 16px;
        display: grid;
        gap: 10px;
      }

      .finding {
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 16px;
        padding: 12px;
        background: rgba(255, 255, 255, 0.045);
      }

      .finding-title {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
        font-weight: 900;
      }

      .finding-title span {
        color: var(--muted);
        font-size: 12px;
        white-space: nowrap;
      }

      .finding p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
        font-size: 14px;
      }

      .tips-card {
        margin-top: 16px;
      }

      .tips {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      @media (max-width: 820px) {
        .tips {
          grid-template-columns: 1fr;
        }
      }

      .tip {
        padding: 14px;
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 18px;
        background: rgba(255,255,255,0.04);
      }

      .tip strong {
        display: block;
        margin-bottom: 7px;
      }

      .tip p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
        font-size: 14px;
      }
    </style>
  </head>

  <body>
    <main class="page">
      <header class="nav">
        <div class="brand">
          <div class="logo">🛡️</div>
          <h1>Cybersecurity Phishing Detector</h1>
        </div>
        <a class="back" href="/apps/">← Back to Apps</a>
      </header>

      <section class="hero">
        <div class="hero-card">
          <p class="eyebrow">Security Awareness Lab</p>
          <h2>Scan suspicious messages before you click.</h2>
          <p>
            Paste an email, text, or direct message. This tool checks for phishing red flags like urgent language,
            credential requests, payment pressure, suspicious links, fake sender patterns, and risky attachments.
          </p>
          <div class="chips">
            <span class="chip">URL analysis</span>
            <span class="chip">Risk scoring</span>
            <span class="chip">Keyword detection</span>
            <span class="chip">Security recommendations</span>
          </div>
        </div>

        <aside class="radar-card">
          <div class="radar" aria-hidden="true">
            <span class="pulse p1"></span>
            <span class="pulse p2"></span>
            <span class="pulse p3"></span>
          </div>
          <p class="radar-caption">
            This is a front-end cybersecurity demo. It does not send your message anywhere and it does not replace professional security tools.
          </p>
        </aside>
      </section>

      <section class="main-grid">
        <div class="tool-card">
          <div class="section-title">
            <h3>Message Scanner</h3>
            <span class="mini">Paste suspicious content below</span>
          </div>

          <label for="senderInput">Sender email or phone number</label>
          <input id="senderInput" type="text" placeholder="Example: support@paypaI-security.com" />

          <label for="subjectInput">Subject or headline</label>
          <input id="subjectInput" type="text" placeholder="Example: Urgent account verification required" />

          <label for="messageInput">Email, text, or DM content</label>
          <textarea id="messageInput" placeholder="Paste the suspicious message here..."></textarea>

          <div class="buttons">
            <button id="scanBtn" type="button">Analyze Message</button>
            <button id="sampleBtn" class="secondary" type="button">Load Sample</button>
            <button id="copyBtn" class="secondary" type="button">Copy Report</button>
            <button id="resetBtn" class="danger" type="button">Reset</button>
          </div>
        </div>

        <div class="result-card">
          <div class="section-title">
            <h3>Threat Report</h3>
            <span class="mini" id="lastScan">Not scanned yet</span>
          </div>

          <div class="score-box">
            <div class="score-ring" id="scoreRing">
              <div class="score-text">
                <strong id="scoreNumber">0</strong>
                <span>risk score</span>
              </div>
            </div>

            <div>
              <div class="risk-pill" id="riskPill">Low Risk</div>
              <p class="summary" id="summaryText">
                Add a message and click Analyze Message. The detector will explain what looks safe or suspicious.
              </p>
            </div>
          </div>

          <div class="stats">
            <div class="stat">
              <strong id="linkCount">0</strong>
              <span>links found</span>
            </div>
            <div class="stat">
              <strong id="flagCount">0</strong>
              <span>red flags</span>
            </div>
            <div class="stat">
              <strong id="wordCount">0</strong>
              <span>words checked</span>
            </div>
          </div>

          <div class="findings" id="findingsList">
            <div class="finding">
              <div class="finding-title">No scan yet <span>Info</span></div>
              <p>Your findings will appear here after the message is analyzed.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="tips-card">
        <div class="section-title">
          <h3>Quick Safety Rules</h3>
          <span class="mini">Use these before clicking anything</span>
        </div>

        <div class="tips">
          <div class="tip">
            <strong>Verify the sender</strong>
            <p>Check the exact domain and watch for lookalike letters, misspellings, or strange email addresses.</p>
          </div>
          <div class="tip">
            <strong>Do not rush</strong>
            <p>Phishing messages often create panic with deadlines, locked accounts, fake invoices, or prize claims.</p>
          </div>
          <div class="tip">
            <strong>Go directly</strong>
            <p>Do not use the message link. Open the company website yourself or contact support through official channels.</p>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      window.addEventListener("DOMContentLoaded", function () {
        const senderInput = document.getElementById("senderInput");
        const subjectInput = document.getElementById("subjectInput");
        const messageInput = document.getElementById("messageInput");
        const scanBtn = document.getElementById("scanBtn");
        const sampleBtn = document.getElementById("sampleBtn");
        const copyBtn = document.getElementById("copyBtn");
        const resetBtn = document.getElementById("resetBtn");
        const scoreRing = document.getElementById("scoreRing");
        const scoreNumber = document.getElementById("scoreNumber");
        const riskPill = document.getElementById("riskPill");
        const summaryText = document.getElementById("summaryText");
        const linkCount = document.getElementById("linkCount");
        const flagCount = document.getElementById("flagCount");
        const wordCount = document.getElementById("wordCount");
        const findingsList = document.getElementById("findingsList");
        const lastScan = document.getElementById("lastScan");

        let latestReport = "No scan has been run yet.";

        function addFinding(findings, title, severity, points, detail) {
          findings.push({ title: title, severity: severity, points: points, detail: detail });
        }

        function getUrls(text) {
          const matches = text.match(/https?:\/\/[^\s)]+|www\.[^\s)]+/gi);
          return matches ? matches : [];
        }

        function getRiskColor(score) {
          if (score >= 75) return "#fb7185";
          if (score >= 45) return "#facc15";
          if (score >= 20) return "#22d3ee";
          return "#34d399";
        }

        function getRiskLabel(score) {
          if (score >= 75) return "High Risk";
          if (score >= 45) return "Medium Risk";
          if (score >= 20) return "Low to Medium Risk";
          return "Low Risk";
        }

        function setRiskStyles(score) {
          const color = getRiskColor(score);
          const degrees = Math.min(score, 100) * 3.6;
          scoreRing.style.background = "conic-gradient(" + color + " " + degrees + "deg, rgba(255,255,255,0.08) " + degrees + "deg)";
          riskPill.textContent = getRiskLabel(score);
          riskPill.style.color = color;
          riskPill.style.borderColor = color;
          riskPill.style.background = "rgba(255,255,255,0.055)";
        }

        function renderFindings(findings) {
          findingsList.innerHTML = "";

          if (findings.length === 0) {
            const clean = document.createElement("div");
            clean.className = "finding";
            clean.innerHTML = '<div class="finding-title">No major red flags found <span>Good</span></div><p>This message does not show obvious phishing patterns. Still verify links and sender identity before taking action.</p>';
            findingsList.appendChild(clean);
            return;
          }

          findings.forEach(function (finding) {
            const card = document.createElement("div");
            card.className = "finding";

            const title = document.createElement("div");
            title.className = "finding-title";
            title.textContent = finding.title;

            const severity = document.createElement("span");
            severity.textContent = finding.severity + " +" + finding.points;
            title.appendChild(severity);

            const detail = document.createElement("p");
            detail.textContent = finding.detail;

            card.appendChild(title);
            card.appendChild(detail);
            findingsList.appendChild(card);
          });
        }

        function analyzeMessage() {
          const sender = senderInput.value.trim();
          const subject = subjectInput.value.trim();
          const message = messageInput.value.trim();
          const combined = (sender + " " + subject + " " + message).toLowerCase();
          const urls = getUrls(combined);
          const words = message ? message.split(/\s+/).filter(Boolean).length : 0;
          const findings = [];
          let score = 0;

          if (!sender && !subject && !message) {
            summaryText.textContent = "Paste a suspicious message first so the detector has something to analyze.";
            return;
          }

          const urgentWords = ["urgent", "immediately", "act now", "final warning", "limited time", "expires", "suspended", "locked", "verify now"];
          const credentialWords = ["password", "login", "sign in", "verify your account", "confirm your account", "security code", "2fa", "ssn", "social security"];
          const moneyWords = ["wire transfer", "gift card", "invoice", "refund", "payment failed", "bank account", "crypto", "bitcoin", "prize", "winner"];
          const attachmentWords = ["attachment", ".zip", ".exe", ".scr", ".bat", "macro", "enable content"];
          const shorteners = ["bit.ly", "tinyurl", "t.co", "goo.gl", "ow.ly", "is.gd", "buff.ly"];
          const suspiciousTlds = [".ru", ".cn", ".tk", ".zip", ".mov", ".top", ".xyz"];

          urgentWords.forEach(function (word) {
            if (combined.includes(word)) {
              score += 8;
              addFinding(findings, "Urgency pressure detected", "Medium", 8, "The message uses time pressure or fear. Phishing often tries to rush you before you think.");
            }
          });

          credentialWords.forEach(function (word) {
            if (combined.includes(word)) {
              score += 10;
              addFinding(findings, "Credential request detected", "High", 10, "The message asks about login, password, account verification, or sensitive identity details.");
            }
          });

          moneyWords.forEach(function (word) {
            if (combined.includes(word)) {
              score += 10;
              addFinding(findings, "Money or payment pressure detected", "High", 10, "The message references payment, invoices, refunds, prizes, gift cards, or financial action.");
            }
          });

          attachmentWords.forEach(function (word) {
            if (combined.includes(word)) {
              score += 12;
              addFinding(findings, "Risky attachment language detected", "High", 12, "Unexpected attachments, executable files, or macro instructions are common malware delivery methods.");
            }
          });

          urls.forEach(function (url) {
            score += 6;
            addFinding(findings, "Link found", "Low", 6, "A link is included. Hover over it, inspect the domain, and avoid clicking from the message directly.");

            shorteners.forEach(function (shortener) {
              if (url.includes(shortener)) {
                score += 12;
                addFinding(findings, "Shortened URL detected", "High", 12, "Shortened links hide the real destination, which increases phishing risk.");
              }
            });

            suspiciousTlds.forEach(function (tld) {
              if (url.includes(tld)) {
                score += 9;
                addFinding(findings, "Suspicious domain ending detected", "Medium", 9, "The link uses a domain ending that is often abused in scams or suspicious campaigns.");
              }
            });
          });

          if (sender && !sender.includes("@") && sender.replace(/\D/g, "").length >= 8) {
            score += 7;
            addFinding(findings, "Phone-number sender detected", "Low", 7, "Text-message phishing often comes from unknown numbers and pushes links or urgent account alerts.");
          }

          if (sender.includes("@") && !sender.includes(".com") && !sender.includes(".edu") && !sender.includes(".org") && !sender.includes(".net")) {
            score += 6;
            addFinding(findings, "Unusual sender domain", "Low", 6, "The sender domain is not a common domain pattern. Verify the exact sender before responding.");
          }

          if (sender.toLowerCase().includes("paypai") || sender.toLowerCase().includes("micros0ft") || sender.toLowerCase().includes("arnazon")) {
            score += 18;
            addFinding(findings, "Lookalike brand spelling", "High", 18, "The sender appears to imitate a trusted brand using swapped or misspelled characters.");
          }

          if (combined.includes("dear customer") || combined.includes("dear user") || combined.includes("valued customer")) {
            score += 5;
            addFinding(findings, "Generic greeting", "Low", 5, "Generic greetings can be normal, but phishing messages often avoid using your real name.");
          }

          if (combined.includes("do not share this") || combined.includes("keep this confidential")) {
            score += 12;
            addFinding(findings, "Secrecy pressure detected", "High", 12, "Scammers often ask victims to keep the request private so others cannot warn them.");
          }

          score = Math.min(score, 100);
          scoreNumber.textContent = String(score);
          linkCount.textContent = String(urls.length);
          flagCount.textContent = String(findings.length);
          wordCount.textContent = String(words);
          setRiskStyles(score);
          renderFindings(findings);

          if (score >= 75) {
            summaryText.textContent = "This message has multiple high-risk phishing indicators. Do not click links, download files, reply, or enter credentials.";
          } else if (score >= 45) {
            summaryText.textContent = "This message has several suspicious signs. Verify it through official channels before taking action.";
          } else if (score >= 20) {
            summaryText.textContent = "This message has some warning signs. Be cautious, especially with links, attachments, and account requests.";
          } else {
            summaryText.textContent = "This message has a low risk score, but you should still verify the sender and avoid clicking unexpected links.";
          }

          lastScan.textContent = "Scanned just now";
          latestReport = "Phishing Detector Report\nRisk Score: " + score + "/100\nRisk Level: " + getRiskLabel(score) + "\nLinks Found: " + urls.length + "\nRed Flags: " + findings.length + "\nWords Checked: " + words + "\nSummary: " + summaryText.textContent;
        }

        scanBtn.addEventListener("click", analyzeMessage);

        sampleBtn.addEventListener("click", function () {
          senderInput.value = "support@paypaI-security.com";
          subjectInput.value = "Urgent: Account locked - verify now";
          messageInput.value = "Dear customer, your account has been suspended due to unusual login activity. Click https://bit.ly/secure-login-update immediately to confirm your password and security code. Failure to act now will permanently lock your account.";
          analyzeMessage();
        });

        copyBtn.addEventListener("click", function () {
          navigator.clipboard.writeText(latestReport).then(function () {
            copyBtn.textContent = "Copied Report";
            setTimeout(function () {
              copyBtn.textContent = "Copy Report";
            }, 1400);
          });
        });

        resetBtn.addEventListener("click", function () {
          senderInput.value = "";
          subjectInput.value = "";
          messageInput.value = "";
          scoreNumber.textContent = "0";
          linkCount.textContent = "0";
          flagCount.textContent = "0";
          wordCount.textContent = "0";
          setRiskStyles(0);
          riskPill.textContent = "Low Risk";
          summaryText.textContent = "Add a message and click Analyze Message. The detector will explain what looks safe or suspicious.";
          lastScan.textContent = "Not scanned yet";
          findingsList.innerHTML = '<div class="finding"><div class="finding-title">No scan yet <span>Info</span></div><p>Your findings will appear here after the message is analyzed.</p></div>';
          latestReport = "No scan has been run yet.";
        });
      });
    </script>
  </body>
</html>
