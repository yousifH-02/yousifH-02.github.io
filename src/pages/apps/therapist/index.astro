---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout title="Reset" category="A little headspace" description="A quiet place to put thoughts into words, choose a small next step, or take a breathing break.">
<div class="reset-modes" role="group" aria-label="Choose a reflection mode"><button class="mode active" data-mode="reflect" aria-pressed="true"><span>01</span><strong>Let it out</strong><small>Make room for what's on your mind.</small></button><button class="mode" data-mode="plan" aria-pressed="false"><span>02</span><strong>Find a next step</strong><small>Turn a tangled thought into one action.</small></button><button class="mode" data-mode="breathe" aria-pressed="false"><span>03</span><strong>Take a moment</strong><small>Follow a gentle breathing rhythm.</small></button></div>
<div class="workspace"><section class="panel"><div id="reflection"><div class="reflection-top"><span id="step-count" class="eyebrow">PROMPT 1 OF 3</span><button id="start-over" class="minor-button">Start over</button></div><h2 id="prompt" class="reflection-prompt">What's taking up space in your mind?</h2><label for="thought" class="label">Your reflection</label><textarea id="thought" rows="7" maxlength="10000" placeholder="Start wherever you want. This is just for you."></textarea><div class="toolbar"><button id="previous" class="button" disabled>← Back</button><button id="next" class="button primary">Next prompt →</button><button id="download" class="minor-button">Save notes</button></div><p id="reflection-status" class="status-message" aria-live="polite"></p></div><div id="breathing" hidden><div class="breath-circle" id="breath-circle"><strong id="breath-label">Settle in</strong><span id="breath-count">Your own pace is okay.</span></div><div class="toolbar breathe-controls"><button id="breath-toggle" class="button primary">Begin breathing</button></div><p class="panel-note">Follow the rhythm only if it feels comfortable. You can stop at any time.</p></div></section><aside class="panel"><span class="pill">Space to think</span><h2 class="panel-title" style="margin-top:25px">No perfect words needed.</h2><p class="panel-note">A sentence, a list, a rough thought. Whatever helps you untangle the moment.</p><hr class="rule"/><h2 class="panel-title">Just on this page.</h2><p class="panel-note">Your notes stay in this tab and are cleared when you reload or leave. Save a copy if you want to keep them.</p><hr class="rule"/><p class="panel-note">Reset uses fixed reflection prompts. It isn't an AI chat, therapist, or medical service.</p></aside></div>
</AppLayout>
<script src="../../../scripts/reset.js"></script>
<style>.reset-modes{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}.mode{text-align:left;background:#181418;border:1px solid var(--line);border-radius:10px;padding:22px;color:var(--text)}.mode.active{background:#2c1b25;border-color:#c45271}.mode>span{color:var(--accent);font:11px monospace}.mode strong{display:block;font-size:18px;font-weight:400;margin:14px 0 9px}.mode small{font-size:12px;line-height:1.5;color:var(--muted)}.reflection-top{display:flex;justify-content:space-between;align-items:center;gap:20px}.reflection-prompt{font-size:30px;line-height:1.2;margin:28px 0 30px;letter-spacing:-.03em}.breath-circle{width:min(260px,85%);aspect-ratio:1;margin:45px auto;border:1px solid #b75773;border-radius:50%;background:radial-gradient(ellipse,#6e2a4055,#241822);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:15px;transition:transform 4s linear}.breath-circle strong{font-size:28px;font-weight:400}.breath-circle span{font-size:12px;color:var(--muted)}.breath-circle.inhale{transform:scale(1.1)}.breathe-controls{justify-content:center}#breathing>.panel-note{text-align:center}@media(max-width:600px){.reset-modes{grid-template-columns:1fr;gap:10px}.mode{padding:16px;display:grid;grid-template-columns:25px 1fr;gap:6px 12px}.mode strong{margin:0;font-size:16px}.mode small{grid-column:2}.mode span{padding-top:4px}.reflection-prompt{font-size:26px}}</style>
