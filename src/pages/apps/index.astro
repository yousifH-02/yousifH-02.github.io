---
import Layout from '../../layouts/Layout.astro';
const apps = [
{name:'Snake',kind:'Games',href:'snake',mark:'↳',num:'01',description:'A familiar game with a sharper edge. Pick a pace, chase the next bite, beat your best.',meta:'Keyboard + touch'},
{name:'Reactor',kind:'Games',href:'reactor',mark:'ϟ',num:'02',description:'One signal. One click. Five rounds to find out just how fast your reflexes really are.',meta:'Reaction challenge'},
{name:'Reset',kind:'Tools',href:'therapist',mark:'◎',num:'03',description:'Clear some headspace with guided reflection, a small next step, or a quiet breathing break.',meta:'Private reflection'},
{name:'Grade calculator',kind:'Tools',href:'grade-calculator',mark:'A+',num:'04',description:'Make the numbers make sense. Calculate weighted grades and plan your final exam.',meta:'Live calculations'},
{name:'Phishing inspector',kind:'Tools',href:'phishing-detector',mark:'⌕',num:'05',description:'Look beneath the message. Examine suspicious wording and links with clear, explainable checks.',meta:'Local analysis'},
];
---
<Layout title="The Lab — Yousif Husni" description="Play games, explore interactive experiments, and try useful browser tools built by Yousif Husni.">
<section class="container lab-index">
  <div class="lab-intro"><div><p class="eyebrow">SIDE PROJECTS / LIVE EXPERIMENTS</p><h1>Less talk.<br/><span>More play.</span></h1></div><div class="intro-right"><span class="lab-stamp">yh / lab</span><p>A little curiosity goes a long way.<br/>Here's where mine ends up.</p><span class="mono">05 EXPERIMENTS · ALL IN YOUR BROWSER</span></div></div>
  <div class="filter-bar"><div role="group" aria-label="Filter experiments"><button class="filter active" data-filter="All" aria-pressed="true">All experiments <span>05</span></button><button class="filter" data-filter="Games" aria-pressed="false">Games <span>02</span></button><button class="filter" data-filter="Tools" aria-pressed="false">Tools <span>03</span></button></div><span id="filter-status" class="mono muted" aria-live="polite">5 experiments</span></div>
  <div class="lab-cards">{apps.map(app=><a class={`lab-card card-${app.href}`} href={`/apps/${app.href}/`} data-category={app.kind}><div class="card-head"><span class="mono">{app.num} / {app.kind}</span><span class="launch">↗</span></div><div class="app-mark" aria-hidden="true">{app.mark}</div><div class="card-copy"><h2>{app.name}</h2><p>{app.description}</p></div><div class="card-foot"><span>{app.meta}</span><span>Launch experiment →</span></div></a>)}</div>
  <a class="standalone-app" href="https://codewatch-yousif.yousniff02.chatgpt.site" target="_blank" rel="noopener noreferrer"><div><p class="eyebrow">INDEPENDENT APP / CODEWATCH</p><h2>A closer look at your code.</h2><p>Explore code patterns, jump to findings, and export a report in a dedicated workspace.</p></div><span class="button primary">Launch CodeWatch ↗</span></a>
  <p class="lab-closing">Built while learning. Improved by doing. <a href="mailto:yousifmoyaser@gmail.com">Have an idea? Let's talk ↗</a></p>
</section>
</Layout>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});let count=0;document.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{card.hidden=button.dataset.filter!=='All'&&card.dataset.category!==button.dataset.filter;if(!card.hidden)count++;});document.querySelector('#filter-status')!.textContent=`${count} experiments`;}));
</script>
<style>
.lab-index{padding:65px 0}.lab-intro{display:flex;justify-content:space-between;align-items:end;gap:40px;padding-bottom:65px}.lab-intro h1{font-size:clamp(74px,9vw,124px);margin-top:30px}.intro-right{max-width:330px}.intro-right p{font-size:21px;line-height:1.5;letter-spacing:-.02em;color:#c5b7be}.intro-right .mono{font-size:10px;color:var(--muted)}.lab-stamp{font:42px ui-monospace,monospace;letter-spacing:-.08em;color:var(--accent)}.filter-bar{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0;border-top:1px solid var(--line);margin-bottom:12px}.filter-bar>div{display:flex;gap:10px;flex-wrap:wrap}.filter{background:transparent;border:1px solid var(--line);border-radius:30px;color:var(--muted);padding:12px 18px;cursor:pointer;font:13px Arial,sans-serif}.filter span{font-size:10px;margin-left:10px;opacity:.65}.filter.active{background:#ff6268;color:#230c0e;border-color:#ff6268}.filter:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.lab-cards{display:grid;grid-template-columns:repeat(6,1fr);gap:24px}.lab-card{grid-column:span 2;border:1px solid var(--line);border-radius:12px;background:#1b161a;padding:26px;transition:transform .2s,border-color .2s;display:flex;flex-direction:column;min-width:0}.lab-card:nth-child(-n+2){grid-column:span 3}.lab-card:hover{transform:translateY(-4px);border-color:#b94960}.card-head{display:flex;justify-content:space-between;align-items:center;color:#b594a1}.card-head .mono{font-size:10px}.launch{font-size:25px;color:var(--accent)}.app-mark{font:80px/1.4 ui-monospace,monospace;letter-spacing:-.08em;color:#ff6268;margin:32px 0;text-align:center;background:radial-gradient(ellipse,#ff626817,transparent 65%)}.lab-card:nth-child(-n+2) .app-mark{font-size:110px;margin:32px 0}.card-copy h2{font-size:28px;margin:0;letter-spacing:-.04em}.card-copy p{color:var(--muted);font-size:14px;line-height:1.8;margin:16px 0 25px}.card-foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:10px;color:#c89eac;padding-top:18px;border-top:1px solid var(--line);margin-top:auto}.lab-closing{color:var(--muted);font-size:13px;margin:38px 0 0;line-height:1.8}.lab-closing a{color:#e4bcc9;margin-left:10px}[hidden]{display:none!important}@media(max-width:1000px){.lab-card{grid-column:span 3}}@media(max-width:620px){.lab-intro{display:block;padding-bottom:35px}.intro-right{margin-top:38px}.lab-stamp{display:none}.filter-bar{display:block}.filter-bar>.mono{display:block;margin-top:20px}.filter{padding:10px 12px;font-size:11px}.filter span{margin-left:4px}.lab-card,.lab-card:nth-child(-n+2){grid-column:span 6}.lab-index{padding-top:38px}.app-mark,.lab-card:nth-child(-n+2) .app-mark{font-size:80px;margin:20px 0}.lab-closing a{display:block;margin:10px 0}}
</style>
