---

<!doctype html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Apps — Yousif Husni</title>

  <meta
    name="description"
    content="Apps, tools, games, and web experiments built by Yousif Husni."
  />

  <style>

    :root {
      --black: #080808;
      --charcoal: #0f0f0f;
      --text: #f2f0eb;
      --muted: #8f8f8b;
      --line: #292929;
      --red: #d84b4b;
      --red-bright: #ee6262;
      --red-soft: rgba(216, 75, 75, 0.1);
      --max: 1240px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--black);
      color: var(--text);

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ::selection {
      background: var(--red);
      color: white;
    }

    .container {
      width: min(calc(100% - 48px), var(--max));
      margin: 0 auto;
    }


    /* NAV */


    .nav {
      position: fixed;
      top: 0;
      left: 0;

      width: 100%;
      z-index: 100;

      background: rgba(8, 8, 8, 0.88);
      backdrop-filter: blur(16px);

      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-inner {
      height: 70px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-size: 15px;
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .back {
      display: flex;
      align-items: center;
      gap: 8px;

      color: var(--muted);
      font-size: 13px;

      transition: color 0.25s ease;
    }

    .back-arrow {
      color: var(--red);
      transition: transform 0.25s ease;
    }

    .back:hover {
      color: var(--text);
    }

    .back:hover .back-arrow {
      transform: translateX(-5px);
    }


    /* HERO */


    .hero {
      min-height: 70vh;

      display: flex;
      align-items: flex-end;

      padding: 160px 0 80px;

      background: var(--black);
      border-bottom: 1px solid var(--line);
    }

    .eyebrow {
      color: var(--red);

      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.17em;
    }

    .hero h1 {
      margin: 25px 0 35px;

      font-size: clamp(90px, 16vw, 210px);
      line-height: 0.76;

      font-weight: 550;
      letter-spacing: -0.08em;
    }

    .hero-bottom {
      display: grid;
      grid-template-columns: 1fr 0.6fr;

      gap: 80px;
      align-items: end;
    }

    .hero-description {
      margin: 0;
      max-width: 720px;

      font-size: clamp(20px, 2.3vw, 30px);
      line-height: 1.35;
      letter-spacing: -0.025em;
    }

    .app-count {
      text-align: right;

      color: var(--muted);

      font-size: 12px;
      line-height: 1.7;
    }

    .app-count strong {
      display: block;

      color: var(--text);

      font-size: 36px;
      font-weight: 500;

      letter-spacing: -0.04em;
    }


    /* APPS */


    .apps-section {
      padding: 100px 0 75px;
      background: var(--charcoal);
    }

    .apps-header {
      display: grid;
      grid-template-columns: 180px 1fr;

      gap: 55px;

      margin-bottom: 55px;
    }

    .apps-header h2 {
      margin: 0;

      font-size: clamp(40px, 5vw, 68px);
      line-height: 1;

      font-weight: 500;
      letter-spacing: -0.055em;
    }

    .app-list {
      border-top: 1px solid var(--line);
    }


    /* APP ROW */


    .app {
      position: relative;

      display: grid;

      grid-template-columns:
        55px
        115px
        minmax(0, 1fr)
        190px
        45px;

      gap: 24px;

      align-items: center;

      padding: 32px 0;

      border-bottom: 1px solid var(--line);

      overflow: hidden;
    }

    .app::before {
      content: "";

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          90deg,
          var(--red-soft),
          transparent 65%
        );

      opacity: 0;

      transition: opacity 0.35s ease;

      pointer-events: none;
    }

    .app:hover::before {
      opacity: 1;
    }

    .app-number {
      position: relative;
      z-index: 1;

      color: var(--red);

      font-size: 11px;

      align-self: start;

      padding-top: 8px;
    }


    /* ICONS */


    .app-icon {
      position: relative;
      z-index: 1;

      width: 95px;
      height: 95px;

      display: flex;
      align-items: center;
      justify-content: center;

      color: #c9c9c6;

      opacity: 0.82;

      transition:
        opacity 0.3s ease,
        transform 0.3s ease;
    }

    .app-icon :global(svg) {
      width: 82px;
      height: 82px;

      fill: none;

      stroke: currentColor;
      stroke-width: 4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .app:hover .app-icon {
      opacity: 1;
      transform: scale(1.05) rotate(-2deg);
    }


    /* APP TEXT */


    .app-main {
      position: relative;
      z-index: 1;

      min-width: 0;
    }

    .app-title {
      margin: 0;

      font-size: clamp(34px, 4.3vw, 62px);
      line-height: 0.95;

      font-weight: 500;
      letter-spacing: -0.06em;

      transition: transform 0.3s ease;
    }

    .app:hover .app-title {
      transform: translateX(6px);
    }

    .app-description {
      margin: 15px 0 0;

      max-width: 700px;

      color: #9e9e9a;

      font-size: 13px;
      line-height: 1.7;
    }

    .app-meta {
      position: relative;
      z-index: 1;

      align-self: end;
    }

    .app-tag {
      color: var(--red);

      font-size: 10px;

      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .app-tech {
      margin-top: 9px;

      color: var(--muted);

      font-size: 11px;
      line-height: 1.5;
    }

    .app-arrow {
      position: relative;
      z-index: 1;

      color: var(--red);

      font-size: 28px;

      transition: transform 0.3s ease;
    }

    .app:hover .app-arrow {
      transform: translateX(8px);
    }


    /* BACK TO MAIN MENU */


    .menu-section {
      padding: 45px 0 65px;

      background: var(--charcoal);
    }

    .menu-button {
      position: relative;

      min-height: 115px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 35px;

      border: 1px solid var(--line);
      border-radius: 18px;

      overflow: hidden;

      transition:
        border-color 0.3s ease,
        background 0.3s ease;
    }

    .menu-button::before {
      content: "";

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          90deg,
          var(--red-soft),
          transparent 65%
        );

      opacity: 0;

      transition: opacity 0.3s ease;
    }

    .menu-button:hover {
      border-color: #3d3d3d;
    }

    .menu-button:hover::before {
      opacity: 1;
    }

    .menu-left,
    .menu-right {
      position: relative;
      z-index: 1;
    }

    .menu-left {
      display: flex;
      align-items: center;

      gap: 28px;

      font-size: clamp(20px, 2vw, 28px);
      letter-spacing: -0.025em;
    }

    .menu-back-arrow {
      color: var(--red);

      font-size: 28px;

      transition: transform 0.3s ease;
    }

    .menu-right {
      color: var(--red);

      font-size: 26px;

      transition: transform 0.3s ease;
    }

    .menu-button:hover .menu-back-arrow {
      transform: translateX(-6px);
    }

    .menu-button:hover .menu-right {
      transform: translateX(6px);
    }


    /* FOOTER */


    .footer {
      padding: 25px 0 45px;
      background: var(--black);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;

      padding-top: 20px;

      border-top: 1px solid var(--line);

      color: var(--muted);

      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }


    /* ANIMATIONS */


    .reveal {
      opacity: 0;

      transform: translateY(24px);

      transition:
        opacity 0.7s ease,
        transform 0.7s ease;

      transition-delay: var(--delay, 0ms);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hero-enter {
      opacity: 0;

      transform: translateY(22px);

      animation:
        heroEnter 0.8s ease forwards;

      animation-delay: var(--delay, 0ms);
    }

    @keyframes heroEnter {

      to {
        opacity: 1;
        transform: translateY(0);
      }

    }


    /* MOBILE */


    @media (max-width: 800px) {

      .container {
        width: calc(100% - 32px);
      }

      .hero {
        min-height: 620px;
        padding: 135px 0 55px;
      }

      .hero h1 {
        font-size: clamp(80px, 28vw, 130px);
      }

      .hero-bottom {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .app-count {
        text-align: left;
      }

      .apps-section {
        padding: 75px 0 55px;
      }

      .apps-header {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .app {
        grid-template-columns:
          32px
          70px
          1fr
          25px;

        gap: 10px;

        padding: 28px 0;
      }

      .app-number {
        grid-column: 1;
      }

      .app-icon {
        grid-column: 2;

        width: 65px;
        height: 65px;
      }

      .app-icon :global(svg) {
        width: 58px;
        height: 58px;
      }

      .app-main {
        grid-column: 3;
      }

      .app-meta {
        grid-column: 3;

        margin-top: 7px;
      }

      .app-arrow {
        grid-column: 4;
        grid-row: 1;

        align-self: center;
      }

      .app-description {
        font-size: 12px;
      }

      .menu-button {
        min-height: 95px;

        padding: 0 20px;
      }

      .menu-left {
        gap: 15px;

        font-size: 18px;
      }

      .footer-inner {
        gap: 20px;
        flex-direction: column;
      }

    }


    @media (max-width: 560px) {

      .app {
        grid-template-columns:
          28px
          58px
          1fr
          20px;
      }

      .app-icon {
        width: 52px;
        height: 52px;
      }

      .app-icon :global(svg) {
        width: 48px;
        height: 48px;

        stroke-width: 4.5;
      }

      .app-title {
        font-size: 30px;
      }

      .app-description {
        margin-top: 10px;
      }

    }


    @media (prefers-reduced-motion: reduce) {

      .reveal,
      .hero-enter {
        opacity: 1;

        transform: none;

        animation: none;
        transition: none;
      }

    }

  </style>

</head>


<body>


  <!-- NAV -->


  <nav class="nav">

    <div class="container nav-inner">

      <a
        href="/"
        class="brand"
      >
        Yousif Husni
      </a>

      <a
        href="/"
        class="back"
      >

        <span class="back-arrow">
          ←
        </span>

        Back to Portfolio

      </a>

    </div>

  </nav>


  <main>


    <!-- HERO -->


    <section class="hero">

      <div class="container">

        <div
          class="eyebrow hero-enter"
          style="--delay: 70ms"
        >
          Selected Experiments
        </div>

        <h1
          class="hero-enter"
          style="--delay: 150ms"
        >
          Apps.
        </h1>

        <div
          class="hero-bottom hero-enter"
          style="--delay: 260ms"
        >

          <p class="hero-description">
            Games, tools, and experiments
            I've built while learning,
            testing ideas, and solving
            problems through code.
          </p>

          <div class="app-count">

            Currently

            <strong>
              05
            </strong>

            apps & experiments

          </div>

        </div>

      </div>

    </section>


    <!-- APP LIST -->


    <section class="apps-section">

      <div class="container">

        <div class="apps-header reveal">

          <div class="eyebrow">
            Explore
          </div>

          <h2>
            Pick something
            and try it.
          </h2>

        </div>


        <div class="app-list">

          {apps.map((app) => (

            <a
              class="app reveal"
              href={app.href}
            >

              <div class="app-number">
                {app.number}
              </div>


              <div
                class="app-icon"
                set:html={icons[app.icon as keyof typeof icons]}
              />


              <div class="app-main">

                <h3 class="app-title">
                  {app.title}
                </h3>

                <p class="app-description">
                  {app.desc}
                </p>

              </div>


              <div class="app-meta">

                <div class="app-tag">
                  {app.tag}
                </div>

                <div class="app-tech">
                  {app.tech}
                </div>

              </div>


              <div class="app-arrow">
                →
              </div>

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- BACK TO MAIN MENU -->


    <section class="menu-section">

      <div class="container">

        <a
          href="/"
          class="menu-button reveal"
        >

          <div class="menu-left">

            <span class="menu-back-arrow">
              ←
            </span>

            <span>
              Back to Main Menu
            </span>

          </div>

          <span class="menu-right">
            →
          </span>

        </a>

      </div>

    </section>


  </main>


  <!-- FOOTER -->


  <footer class="footer">

    <div class="container footer-inner">

      <span>
        © 2026 Yousif Husni
      </span>

      <span>
        Houston, Texas
      </span>

    </div>

  </footer>


  <script is:inline>

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;


    const elements =
      document.querySelectorAll(
        ".reveal"
      );


    if (reducedMotion) {

      elements.forEach(
        element => {

          element.classList.add(
            "visible"
          );

        }
      );

    }

    else {

      const observer =
        new IntersectionObserver(
          entries => {

            entries.forEach(
              entry => {

                if (
                  entry.isIntersecting
                ) {

                  entry.target
                    .classList
                    .add(
                      "visible"
                    );

                  observer.unobserve(
                    entry.target
                  );

                }

              }
            );

          },
          {
            threshold: 0.1,

            rootMargin:
              "0px 0px -7% 0px"
          }
        );


      elements.forEach(
        (element, index) => {

          element.style
            .setProperty(
              "--delay",
              `${(index % 4) * 60}ms`
            );

          observer.observe(
            element
          );

        }
      );

    }

  </script>


</body>

</html>