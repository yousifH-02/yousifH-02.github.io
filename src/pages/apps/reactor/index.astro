---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout title="Reactor" category="Reaction challenge" description="Wait for the signal. React as fast as you can. Complete five rounds to see your median reaction time.">
<div class="stat-row"><div><span>Personal best</span><strong id="best">—</strong></div><div><span>Session median</span><strong id="median">—</strong></div><div><span>Rounds</span><strong id="rounds">0 / 5</strong></div></div>
<div class="workspace"><section class="panel reactor-panel"><button id="arena" class="arena" data-state="idle"><span id="signal-icon" aria-hidden="true">ϟ</span><strong id="signal">Ready when you are.</strong><span id="signal-hint">Click, tap, or press Space to begin.</span></button><div class="toolbar"><button id="restart" class="button">New session</button><button id="copy-result" class="button" disabled>Copy result</button><button id="clear-best" class="minor-button">Reset best</button></div><p id="reactor-status" class="status-message" aria-live="polite"></p></section><aside class="panel"><h2 class="panel-title">A test of timing.</h2><ol class="help-list"><li>Start a round, then hold still.</li><li>Wait until you see <strong>GO</strong> and the panel changes color.</li><li>React with a click, tap, or Space.</li><li>Five valid rounds make a session. False starts don't count.</li></ol><hr class="rule"/><h2 class="panel-title">This session</h2><ol id="results" class="round-results"></ol><p class="panel-note">Your device and browser affect timing. Compare your own sessions, not laboratory benchmarks.</p></aside></div>
</AppLayout>
<script src="../../../scripts/reactor.js"></script>
<style>.arena{width:100%;min-height:365px;border:1px solid #694049;border-radius:10px;background:radial-gradient(ellipse at center,#5c213450,#1b1419 70%);color:var(--text);display:flex;flex-direction:column;justify-content:center;align-items:center;padding:24px;gap:22px;touch-action:manipulation}.arena #signal-icon{font-size:88px;line-height:1;color:var(--accent)}.arena strong{font-size:30px;font-weight:400;letter-spacing:-.03em}.arena>span:last-child{font-size:13px;color:var(--muted);line-height:1.6}.arena[data-state=waiting]{background:#38202a}.arena[data-state=go]{background:#a8e4c3;color:#0e2b1d;border-color:#a8e4c3}.arena[data-state=go] #signal-icon,.arena[data-state=go]>span:last-child{color:#16492f}.round-results{padding-left:24px;color:var(--muted);font:14px/2 ui-monospace,monospace}.reactor-panel{padding:18px}@media(max-width:500px){.arena{min-height:320px}.arena strong{font-size:24px}}</style>
