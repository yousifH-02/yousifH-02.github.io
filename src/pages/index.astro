---
import Layout from "../layouts/Layout.astro";

const experiences = [
  {
    role: "Project Hedgehog",
    company: "Handshake AI",
    date: "Apr 2026 — Present",
    summary: "AI evaluation and structured human feedback.",
    detail:
      "Evaluate AI-generated images against user prompts and review image and AI-generated voice-prompt tasks. Provide structured feedback to support AI model improvement.",
  },
  {
    role: "Front Desk Supervisor",
    company: "Hospitality",
    date: "Aug 2025 — Present",
    summary: "Operations, systems, billing, and customer service.",
    detail:
      "Use the FOSSE hotel system to manage reservations, check-ins, billing, and customer data while supporting day-to-day hotel operations.",
  },
  {
    role: "Sales Associate",
    company: "Aldi",
    date: "Feb 2025 — Aug 2025",
    summary: "Customer service, inventory, and store operations.",
    detail:
      "Worked across customer service, inventory, transactions, stock flow, and process-focused store operations.",
  },
  {
    role: "Sales Supervisor",
    company: "Burlington",
    date: "Feb 2021 — Feb 2022",
    summary: "Sales operations, POS, inventory, and customer service.",
    detail:
      "Supported customer service, POS operations, inventory flow, and daily sales activities.",
  },
];

const projects = [
  {
    number: "01",
    title: "Yubii",
    type: "Pfizer Research",
    metric: "91%+ sensitivity",
    stack: "Python · PyTorch · Next.js · Supabase · AWS",
    description:
      "Machine-learning research using 195+ patient voice recordings, paired with a full-stack conversational interface built with Next.js, OAuth, Supabase, Vercel, and AWS CloudFront.",
  },
  {
    number: "02",
    title: "CodeWatch",
    type: "Independent Browser App",
    metric: "100% local analysis",
    stack: "JavaScript · Explainable Rules · Browser APIs",
    description:
      "A standalone code-inspection workspace with line-level findings, local file loading, and downloadable reports. Your source stays on your device.",
  },
];

---
<Layout>
  <section class="hero container" id="top">
    <div class="hero-top"><span class="eyebrow"><i></i> Open to software opportunities</span><span class="mono location">Houston, Texas / 29.76° N</span></div>
    <div class="hero-grid">
      <div><p class="overline">DEVELOPER · BUILDER · CURIOUS HUMAN</p><h1>Yousif<br/><span>Husni.</span></h1><p class="hero-description">Turning ideas into software.<br/>And data into something useful.</p><p class="muted intro">Computer science at the University of Houston.<br/>Full-stack development & applied AI.</p><div class="actions"><a class="button primary" href="#projects">Explore my work <span>↘</span></a><a class="button" href="/resume/">View resume ↗</a></div></div>
      <div class="orbit-art" aria-hidden="true"><div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="core">yh<span>_</span></div><span class="art-label label-top">IDEAS → SYSTEMS</span><span class="art-label label-bottom">ALWAYS A WORK IN PROGRESS.</span><span class="coordinate">+<br/><br/>+</span></div>
    </div>
    <div class="hero-footer mono"><span>FULL-STACK / MACHINE LEARNING</span><a href="#projects">SCROLL TO EXPLORE ↓</a><span>PORTFOLIO / 2026</span></div>
  </section>
  <section id="projects" class="section container">
    <div class="section-head"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Built with purpose.</h2></div><p class="muted">A few things I've been<br/>thinking about. And building.</p></div>
    <div class="project-grid">{projects.map((project, index) => <article class:list={["project-card", index === 0 ? "voice-card" : "code-card"]}>
      <div class="project-visual" aria-hidden="true"><div class="visual-top mono"><span>{index === 0 ? "VOICE → INSIGHT" : "CODE → SIGNAL"}</span><span>0{index + 1}</span></div>{index === 0 ? <div class="wave">{Array.from({length: 41}, (_, i) => <span style={`--h:${18 + Math.abs(Math.sin(i * .73) * Math.cos(i * .18)) * 110}px;--d:${i * 35}ms`}></span>)}</div> : <div class="code-art"><span class="code-comment">// look beyond the syntax</span><br/><span class="code-keyword">const</span> insight = <span class="code-function">detect</span>({'{'}<br/>&nbsp; source: <span class="code-string">"your source code"</span>,<br/>&nbsp; mode: <span class="code-string">"local inspection"</span><br/>{'}'});<span class="code-cursor">▌</span></div>}<div class="visual-bottom mono"><span>{index === 0 ? "APPLIED MACHINE LEARNING" : "CODE PATTERN INSPECTION"}</span><span>↗</span></div></div>
      <div class="project-body"><p class="eyebrow">{project.type}</p><h3>{project.title}</h3><p class="muted">{project.description}</p><div class="metric"><strong>{project.metric}</strong><span>{index === 0 ? "StratifiedGroupKFold validation" : "No upload. No account required."}</span></div><details><summary>Explore the project <span>+</span></summary><p>{index === 0 ? "Trained a Random Forest classifier on 195+ patient voice recordings. A separate UPDRS symptom predictor uses 16 vocal features across 5,875 recordings, achieving MAE below 7.0. The conversational interface connects Next.js, Gmail OAuth, and Supabase." : "Built from scratch as an independent browser edition. CodeWatch explains repeated lines, unfinished work, debugging calls, and other review cues. It uses transparent text rules and does not claim to determine AI authorship."}</p></details><p class="stack mono">{project.stack}</p>{index === 1 && <a class="button primary project-launch" href="https://codewatch-yousif.yousniff02.chatgpt.site" target="_blank" rel="noopener noreferrer">Launch CodeWatch ↗</a>}</div>
    </article>)}</div>
    <a class="playground" href="/apps/"><div><span class="eyebrow">THE PLAYGROUND</span><h3>Small builds. Big curiosity.</h3><p class="muted">Five games, tools, and experiments. Try something out.</p></div><span class="big-arrow">↗</span></a>
  </section>
  <section id="about" class="section about-section"><div class="container about-grid"><div><p class="eyebrow">02 / A LITTLE ABOUT ME</p><h2>Serious about building.<br/><span class="muted">Curious about everything.</span></h2></div><div><p class="body-copy">I'm a Houston-based computer science student who likes making useful things, from full-stack web applications to machine-learning experiments.</p><p class="muted body-copy">Balancing work and school has taught me discipline, time management, and how to keep moving. Away from the keyboard, you'll find me at the gym, watching UFC, or hanging out with my cat.</p><div class="tags"><span>Gym regular</span><span>UFC fan</span><span>Cat dad</span><span>2× hackathon winner</span></div><div class="education"><span class="mono">UNIVERSITY OF HOUSTON</span><p>B.S. Computer Science <span class="muted">/ May 2027 expected</span></p><span class="mono">WHARTON COUNTY JUNIOR COLLEGE</span><p>A.S. Computer Science <span class="muted">/ May 2024</span></p></div></div></div></section>
  <section id="experience" class="section container"><div class="section-head"><div><p class="eyebrow">03 / THE JOURNEY</p><h2>People. Systems. AI.</h2></div><span class="muted">Experience that shapes how I build.</span></div><div class="experience-list">{experiences.map(item => <details class="experience"><summary><span><strong>{item.role}</strong><span class="muted company">{item.company}</span></span><span class="mono date">{item.date}</span><span class="plus">+</span></summary><p class="muted">{item.detail}</p></details>)}</div></section>
  <section id="skills" class="section container"><div class="section-head"><div><p class="eyebrow">04 / MY TOOLKIT</p><h2>From model to interface.</h2></div><a class="text-link" href="/certifications/">Certifications ↗</a></div><div class="skill-grid">{[{name:'Languages',items:'Python / C / C++ / Java / JavaScript / SQL'},{name:'Frameworks & libraries',items:'React / Next.js / Node.js / PyTorch'},{name:'Tools & platforms',items:'Git / GitHub / Supabase / Vercel / AWS CloudFront / OAuth'},{name:'Foundations',items:'Full-stack development / Machine learning / REST APIs / Data structures & algorithms'}].map((skill, i) => <div><span class="mono muted">0{i+1}</span><h3>{skill.name}</h3><p class="muted">{skill.items}</p></div>)}</div></section>
  <section id="contact" class="section container contact-section"><p class="eyebrow">05 / WHAT'S NEXT?</p><h2>Have something<br/>in mind<span>?</span></h2><div class="contact-bottom"><p class="muted">A project, an opportunity, or a good conversation.<br/>I'd love to hear from you.</p><a class="button primary" href="mailto:yousifmoyaser@gmail.com">Let's talk ↗</a></div><div class="social-links"><a href="https://github.com/yousifH-02" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/yousif-husni" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/resume/">Resume ↗</a><a href="/contact/">More ways to connect ↗</a></div></section>
</Layout>
