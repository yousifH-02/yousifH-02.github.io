  <script is:inline>

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

    /* REVEAL */

    const revealElements =
      document.querySelectorAll(
        ".reveal"
      );

    if (reducedMotion) {

      revealElements.forEach(
        (element) => {
          element.classList.add(
            "revealed"
          );
        }
      );

    } else {

      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach(
              (entry) => {

                if (
                  entry.isIntersecting
                ) {

                  entry.target
                    .classList
                    .add(
                      "revealed"
                    );

                }

              }
            );

          },
          {
            threshold: 0.12,
            rootMargin:
              "0px 0px -8% 0px",
          }
        );

      revealElements.forEach(
        (element,index) => {

          element.style
            .setProperty(
              "--delay",
              `${(index % 3) * 55}ms`
            );

          observer.observe(
            element
          );

        }
      );

    }

    /* EXPERIENCE */

    document
      .querySelectorAll(
        ".experience-button"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const experience =
                button.closest(
                  ".experience"
                );

              if (!experience) {
                return;
              }

              const isOpen =
                experience
                  .classList
                  .toggle(
                    "open"
                  );

              button.setAttribute(
                "aria-expanded",
                String(isOpen)
              );

            }
          );

        }
      );

    /* ACTIVE NAV */

    const sectionLinks =
      document.querySelectorAll(
        ".section-link"
      );

    const sectionData =
      Array
        .from(sectionLinks)
        .map(
          (link) => {

            const href =
              link.getAttribute(
                "href"
              );

            if (!href) {
              return null;
            }

            const section =
              document.querySelector(
                href
              );

            if (!section) {
              return null;
            }

            return {
              link,
              section
            };

          }
        )
        .filter(Boolean);

    const navObserver =
      new IntersectionObserver(
        (entries) => {

          entries.forEach(
            (entry) => {

              if (
                !entry.isIntersecting
              ) {
                return;
              }

              sectionLinks.forEach(
                (link) => {
                  link.classList
                    .remove(
                      "active"
                    );
                }
              );

              const match =
                sectionData.find(
                  (item) =>
                    item.section ===
                    entry.target
                );

              if (match) {

                match.link
                  .classList
                  .add(
                    "active"
                  );

              }

            }
          );

        },
        {
          rootMargin:
            "-35% 0px -55% 0px",

          threshold: 0.01,
        }
      );

    sectionData.forEach(
      (item) => {

        navObserver.observe(
          item.section
        );

      }
    );

    /* HERO PARALLAX */

    if (
      !reducedMotion &&
      window.innerWidth > 800
    ) {

      const heroTitle =
        document.querySelector(
          ".hero-title"
        );

      let ticking = false;

      const updateHero = () => {

        if (!heroTitle) {
          return;
        }

        const y =
          Math.min(
            window.scrollY,
            700
          );

        heroTitle.style
          .transform =
            `translateY(${y * 0.055}px)`;

        ticking = false;

      };

      window.addEventListener(
        "scroll",
        () => {

          if (!ticking) {

            requestAnimationFrame(
              updateHero
            );

            ticking = true;

          }

        },
        {
          passive: true
        }
      );

    }

  </script>

