---
const experiences = [
  {
    role: "Project Hedgejoh",
    company: "Handshake AI",
    date: "Apr 2026 — Present",
    summary: "AI evaluation and structured human feedback.",
    detail:
      "Evaluate AI-generated images against user prompts and review image and AI-generated voice-prompt tasks. Provide structured feedback to support AI model improvement.",
  },
  {
    role: "Front Desk Supervisor",
    company: "Hospitality",
    date: "Aug 2025 — Present",
    summary: "Operations, systems, billing, and customer service.",
    detail:
      "Use the FOSSE hotel system to manage reservations, check-ins, billing, and customer data while supporting day-to-day hotel operations.",
  },
  {
    role: "Sales Associate",
    company: "Aldi",
    date: "Feb 2025 — Aug 2025",
    summary: "Customer service, inventory, and store operations.",
    detail:
      "Worked across customer service, inventory, transactions, stock flow, and process-focused store operations.",
  },
  {
    role: "Sales Supervisor",
    company: "Burlington",
    date: "Feb 2021 — Feb 2022",
    summary: "Sales operations, POS, inventory, and customer service.",
    detail:
      "Supported customer service, POS operations, inventory flow, and daily sales activities.",
  },
];

const projects = [
  {
    number: "01",
    title: "Senior Sequence Project",
    type: "Pfizer Research",
    metric: "91%+ sensitivity",
    stack: "Python · PyTorch · Next.js · Supabase · AWS",
    description:
      "Machine-learning research using 195+ patient voice recordings, paired with a full-stack conversational interface built with Next.js, OAuth, Supabase, Vercel, and AWS CloudFront.",
  },
  {
    number: "02",
    title: "CodeWatch",
    type: "AI Code Detection Platform",
    metric: "~85% accuracy",
    stack: "Python · PyTorch · CodeT5+ · GPT-4o-mini",
    description:
      "AI-generated code detection using a dual-model architecture and GraphCodeBERT fine-tuning on CodeNet C++ data, reducing false positives by roughly 40%.",
  },
];
---

<!doctype html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Yousif Husni — Software Engineer
  </title>

  <meta
    name="description"
    content="Portfolio of Yousif Husni, a Houston-based Computer Science student and software engineer focused on full-stack development and applied AI."
  />

  <style>

    :root {
      --black: #080808;
      --charcoal: #0f0f0f;
      --charcoal-light: #131313;

      --text: #f2f0eb;
      --muted: #92928f;
      --line: #292929;

      --red: #d84b4b;
      --red-bright: #ee6262;
      --red-soft: rgba(216, 75, 75, 0.1);

      --max: 1240px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      background: var(--black);
      color: var(--text);

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    ::selection {
      background: var(--red);
      color: white;
    }

    .container {
      width: min(
        calc(100% - 48px),
        var(--max)
      );

      margin: 0 auto;
    }

    /* NAV */

    .nav {
      position: fixed;

      top: 0;
      left: 0;

      width: 100%;

      z-index: 100;

      background:
        rgba(8, 8, 8, 0.86);

      backdrop-filter:
        blur(16px);

      border-bottom:
        1px solid rgba(255,255,255,0.05);
    }

    .nav-inner {
      height: 70px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-size: 15px;
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .nav-links a {
      position: relative;

      color: #888;

      font-size: 13px;

      transition:
        color 0.25s ease;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a::after {
      content: "";

      position: absolute;

      left: 0;
      bottom: -7px;

      width: 100%;
      height: 1px;

      background: var(--red);

      transform: scaleX(0);
      transform-origin: right;

      transition:
        transform 0.3s ease;
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .nav-links a.active {
      color: var(--text);
    }

    .nav-links a.active::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .resume-nav {
      color: #aaa !important;
    }

    /* HERO */

    .hero {
      min-height: 100vh;

      display: flex;
      align-items: flex-end;

      padding:
        150px 0 80px;

      background:
        var(--black);

      border-bottom:
        1px solid var(--line);

      overflow: hidden;
    }

    .status {
      display: flex;
      align-items: center;

      gap: 9px;

      color: var(--muted);

      text-transform: uppercase;

      letter-spacing: 0.16em;

      font-size: 10px;
    }

    .status-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--red);

      box-shadow:
        0 0 0 4px var(--red-soft);
    }

    .hero-title {
      margin:
        32px 0 36px;

      font-size:
        clamp(
          76px,
          13vw,
          175px
        );

      line-height: 0.79;

      letter-spacing:
        -0.075em;

      font-weight: 550;

      will-change: transform;
    }

    .hero-bottom {
      display: grid;

      grid-template-columns:
        1.35fr 0.65fr;

      gap: 70px;

      align-items: end;
    }

    .hero-description {
      margin: 0;

      max-width: 790px;

      font-size:
        clamp(
          21px,
          2.4vw,
          33px
        );

      line-height: 1.3;

      letter-spacing:
        -0.025em;
    }

    .hero-actions {
      display: flex;

      justify-content:
        flex-end;

      gap: 22px;

      font-size: 14px;
    }

    .link {
      display: inline-flex;

      align-items: center;

      gap: 8px;
    }

    .arrow {
      display: inline-block;

      color: var(--red);

      transition:
        transform 0.25s ease;
    }

    .link:hover .arrow {
      transform:
        translateX(5px);
    }

    /* SECTION SYSTEM */

    .section {
      padding:
        115px 0;

      border-bottom:
        1px solid var(--line);
    }

    .section-dark {
      background:
        var(--black);
    }

    .section-charcoal {
      background:
        var(--charcoal);
    }

    .section-light {
      background:
        var(--charcoal-light);
    }

    .section-heading {
      display: grid;

      grid-template-columns:
        190px 1fr;

      gap: 55px;

      margin-bottom: 70px;
    }

    .eyebrow {
      padding-top: 9px;

      color: var(--red);

      font-size: 10px;

      letter-spacing:
        0.17em;

      text-transform:
        uppercase;
    }

    .section-heading h2 {
      margin: 0;

      max-width: 930px;

      font-size:
        clamp(
          42px,
          5.5vw,
          74px
        );

      font-weight: 500;

      line-height: 1;

      letter-spacing:
        -0.055em;
    }

    /* ABOUT */

    .about-grid {
      display: grid;

      grid-template-columns:
        190px 1fr;

      gap: 55px;
    }

    .about-content {
      grid-column: 2;

      max-width: 820px;
    }

    .about-content p {
      margin:
        0 0 25px;

      color: #b3b3af;

      font-size: 18px;

      line-height: 1.75;
    }

    .about-content p:last-child {
      margin-bottom: 0;
    }

    .tags {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;

      margin-top: 32px;
    }

    .tag {
      padding:
        8px 12px;

      border:
        1px solid #333;

      border-radius:
        999px;

      color: #aaa;

      font-size: 11px;

      transition:
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .tag:hover {
      color: white;

      border-color:
        rgba(216,75,75,0.65);
    }

    /* EXPERIENCE */

    .experience-list {
      border-top:
        1px solid var(--line);
    }

    .experience {
      border-bottom:
        1px solid var(--line);
    }

    .experience-button {
      width: 100%;

      padding:
        27px 0;

      border: none;

      background:
        transparent;

      color: inherit;

      cursor: pointer;

      text-align: left;

      display: grid;

      grid-template-columns:
        1.1fr 1fr 175px 30px;

      align-items: center;

      gap: 30px;
    }

    .experience-role {
      font-size:
        clamp(
          23px,
          3vw,
          36px
        );

      letter-spacing:
        -0.035em;

      transition:
        transform 0.25s ease;
    }

    .experience-button:hover
    .experience-role {
      transform:
        translateX(7px);
    }

    .experience-company {
      color: #aaa;

      font-size: 13px;

      line-height: 1.6;
    }

    .experience-date {
      color: var(--muted);

      font-size: 12px;
    }

    .plus {
      color: var(--red);

      font-size: 24px;

      font-weight: 300;

      transition:
        transform 0.3s ease;
    }

    .experience.open
    .plus {
      transform:
        rotate(45deg);
    }

    .experience-detail {
      display: grid;

      grid-template-columns:
        1.1fr 1fr 175px 30px;

      gap: 30px;

      max-height: 0;

      opacity: 0;

      overflow: hidden;

      transition:
        max-height 0.5s ease,
        opacity 0.3s ease,
        padding 0.5s ease;
    }

    .experience.open
    .experience-detail {
      max-height: 250px;

      opacity: 1;

      padding-bottom: 30px;
    }

    .experience-detail p {
      grid-column: 2 / 4;

      margin: 0;

      max-width: 680px;

      color: #999;

      font-size: 13px;

      line-height: 1.7;
    }

    /* PROJECTS */

    .projects {
      border-top:
        1px solid var(--line);
    }

    .project {
      display: grid;

      grid-template-columns:
        70px 1fr;

      gap: 25px;

      padding:
        38px 0;

      border-bottom:
        1px solid var(--line);
    }

    .project-number {
      padding-top: 8px;

      color: var(--red);

      font-size: 11px;
    }

    .project-title {
      margin: 0;

      font-size:
        clamp(
          45px,
          6.5vw,
          86px
        );

      line-height: 1;

      font-weight: 500;

      letter-spacing:
        -0.06em;

      transition:
        transform 0.3s ease;
    }

    .project:hover
    .project-title {
      transform:
        translateX(8px);
    }

    .project-type {
      margin-top: 10px;

      color: var(--red);

      font-size: 12px;
    }

    .project-info {
      display: grid;

      grid-template-columns:
        0.8fr 1.2fr;

      gap: 50px;

      margin-top: 36px;
    }

    .project-metric {
      font-size:
        clamp(
          22px,
          3vw,
          35px
        );

      line-height: 1.15;

      letter-spacing:
        -0.035em;
    }

    .project-stack {
      margin-top: 15px;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.6;
    }

    .project-description {
      margin: 0;

      color: #aaa;

      font-size: 13px;

      line-height: 1.7;
    }

    /* APPS */

    .apps-link {
      display: flex;

      align-items: center;

      justify-content:
        space-between;

      padding:
        30px 0;

      border-bottom:
        1px solid var(--line);

      font-size: 22px;

      transition:
        padding-left 0.25s ease;
    }

    .apps-link:hover {
      padding-left: 8px;
    }

    .apps-link:hover
    .arrow {
      transform:
        translateX(7px);
    }

    /* SKILLS */

    .skills {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      border-top:
        1px solid var(--line);
    }

    .skill-column {
      padding:
        27px 26px 0 0;

      border-right:
        1px solid var(--line);
    }

    .skill-column:not(:first-child) {
      padding-left: 26px;
    }

    .skill-column:last-child {
      border-right: none;
    }

    .skill-column h3 {
      margin:
        0 0 22px;

      color: var(--red);

      font-size: 10px;

      font-weight: 500;

      letter-spacing:
        0.14em;

      text-transform:
        uppercase;
    }

    .skill-column p {
      margin: 0;

      font-size: 15px;

      line-height: 2;
    }

    /* RESUME */

    .resume-content {
      display: grid;

      grid-template-columns:
        1fr auto;

      align-items: flex-end;

      gap: 50px;
    }

    .resume-content h2 {
      margin:
        15px 0 0;

      max-width: 750px;

      font-size:
        clamp(
          44px,
          6vw,
          78px
        );

      line-height: 0.98;

      font-weight: 500;

      letter-spacing:
        -0.055em;
    }

    .resume-links {
      display: flex;

      flex-wrap: wrap;

      gap: 20px;

      font-size: 13px;
    }

    /* CONTACT */

    .contact {
      padding:
        110px 0 50px;

      background:
        var(--black);
    }

    .contact h2 {
      margin:
        15px 0 0;

      font-size:
        clamp(
          60px,
          9vw,
          125px
        );

      line-height: 0.85;

      font-weight: 500;

      letter-spacing:
        -0.07em;
    }

    .contact-links {
      margin-top: 70px;

      border-top:
        1px solid var(--line);
    }

    .contact-links a {
      display: flex;

      justify-content:
        space-between;

      align-items:
        center;

      padding:
        19px 0;

      border-bottom:
        1px solid var(--line);

      font-size: 17px;

      transition:
        padding-left 0.25s ease;
    }

    .contact-links a:hover {
      padding-left: 8px;
    }

    .contact-destination {
      color: var(--muted);

      font-size: 13px;
    }

    .contact-links a:hover
    .contact-destination {
      color: var(--red);
    }

    .footer {
      display: flex;

      justify-content:
        space-between;

      margin-top: 65px;

      color: var(--muted);

      font-size: 10px;

      text-transform:
        uppercase;

      letter-spacing:
        0.1em;
    }

    /* REVEALS */

    .reveal {
      opacity: 0;

      transform:
        translateY(25px);

      transition:
        opacity 0.75s ease,
        transform 0.75s ease;

      transition-delay:
        var(--delay,0ms);
    }

    .reveal.revealed {
      opacity: 1;

      transform:
        translateY(0);
    }

    .hero-enter {
      opacity: 0;

      transform:
        translateY(22px);

      animation:
        heroEnter 0.9s ease forwards;

      animation-delay:
        var(--delay,0ms);
    }

    @keyframes heroEnter {
      to {
        opacity: 1;

        transform:
          translateY(0);
      }
    }

    :focus-visible {
      outline:
        2px solid var(--red);

      outline-offset:
        5px;
    }

    /* MOBILE */

    @media
    (max-width:800px) {

      .container {
        width:
          calc(100% - 32px);
      }

      .nav-links
      a:not(.resume-nav) {
        display: none;
      }

      .hero {
        min-height: 780px;

        padding-bottom: 55px;
      }

      .hero-title {
        font-size:
          clamp(
            68px,
            22vw,
            115px
          );
      }

      .hero-bottom {
        grid-template-columns:
          1fr;

        gap: 35px;
      }

      .hero-actions {
        justify-content:
          flex-start;
      }

      .section {
        padding:
          85px 0;
      }

      .section-heading,
      .about-grid {
        grid-template-columns:
          1fr;

        gap: 24px;
      }

      .about-content {
        grid-column: 1;
      }

      .experience-button {
        grid-template-columns:
          1fr 30px;

        gap: 12px;
      }

      .experience-company,
      .experience-date {
        grid-column: 1;
      }

      .plus {
        grid-column: 2;
        grid-row: 1;
      }

      .experience-detail {
        grid-template-columns:
          1fr;
      }

      .experience-detail p {
        grid-column: 1;
      }

      .project {
        grid-template-columns:
          35px 1fr;
      }

      .project-info {
        grid-template-columns:
          1fr;

        gap: 25px;
      }

      .skills {
        grid-template-columns:
          1fr;
      }

      .skill-column,
      .skill-column:not(:first-child) {
        padding:
          24px 0;

        border-right: none;

        border-bottom:
          1px solid var(--line);
      }

      .skill-column:last-child {
        border-bottom: none;
      }

      .resume-content {
        grid-template-columns:
          1fr;
      }

      .contact {
        padding-top: 85px;
      }

    }

    @media
    (prefers-reduced-motion:reduce) {

      html {
        scroll-behavior:
          auto;
      }

      .reveal,
      .hero-enter {
        opacity: 1;

        transform: none;

        animation: none;

        transition: none;
      }

      .hero-title {
        transform:
          none !important;
      }

    }

  </style>

</head>

<body>

  <!-- NAV -->

  <nav class="nav">

    <div class="container nav-inner">

      <a
        href="#top"
        class="brand"
      >
        Yousif Husni
      </a>

      <div class="nav-links">

        <a
          href="#about"
          class="section-link"
        >
          About
        </a>

        <a
          href="#experience"
          class="section-link"
        >
          Experience
        </a>

        <a
          href="#projects"
          class="section-link"
        >
          Projects
        </a>

        <a
          href="#skills"
          class="section-link"
        >
          Skills
        </a>

        <a
          href="#contact"
          class="section-link"
        >
          Contact
        </a>

        <a
          href="/resume.pdf"
          target="_blank"
          class="resume-nav"
        >
          Resume ↗
        </a>

      </div>

    </div>

  </nav>

  <main id="top">

    <!-- HERO -->

    <section class="hero">

      <div class="container">

        <div
          class="status hero-enter"
          style="--delay:80ms"
        >
          <span class="status-dot"></span>

          Open to software opportunities
        </div>

        <h1
          class="hero-title hero-enter"
          style="--delay:180ms"
        >
          Yousif<br />
          Husni
        </h1>

        <div
          class="hero-bottom hero-enter"
          style="--delay:300ms"
        >

          <p class="hero-description">
            Houston-based developer focused on
            full-stack development and applied AI.
          </p>

          <div class="hero-actions">

            <a
              href="#projects"
              class="link"
            >
              View my work
              <span class="arrow">
                →
              </span>
            </a>

            <a
              href="/resume.pdf"
              target="_blank"
              class="link"
            >
              Resume
              <span class="arrow">
                ↗
              </span>
            </a>

          </div>

        </div>

      </div>

    </section>

    <!-- ABOUT -->

    <section
      class="section section-charcoal"
      id="about"
    >

      <div class="container">

        <div class="section-heading reveal">

          <div class="eyebrow">
            About Me
          </div>

          <h2>
            Developer, student,
            gym regular, UFC fan,
            and cat owner.
          </h2>

        </div>

        <div class="about-grid reveal">

          <div class="about-content">

            <p>
              I'm Houston-based and have been
              balancing work and school for as
              long as I can remember. That has
              taught me how to stay disciplined,
              manage my time, and keep moving
              toward the things I want to build.
            </p>

            <p>
              Outside of school and work, I enjoy
              going to the gym, watching UFC,
              taking care of my cat, and spending
              time web developing and experimenting
              with new ideas. I like building things
              that are useful, learning as I go,
              and constantly improving my skills.
            </p>

            <div class="tags">

              <span class="tag">
                Houston
              </span>

              <span class="tag">
                Web Development
              </span>

              <span class="tag">
                Gym
              </span>

              <span class="tag">
                UFC
              </span>

              <span class="tag">
                Cat Dad
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- EXPERIENCE -->

    <section
      class="section section-dark"
      id="experience"
    >

      <div class="container">

        <div class="section-heading reveal">

          <div class="eyebrow">
            Experience
          </div>

          <h2>
            Work across AI,
            systems, operations,
            and people.
          </h2>

        </div>

        <div class="experience-list reveal">

          {experiences.map((item) => (

            <article class="experience">

              <button
                class="experience-button"
                type="button"
                aria-expanded="false"
              >

                <span class="experience-role">
                  {item.role}
                </span>

                <span class="experience-company">

                  {item.company}

                  <br />

                  {item.summary}

                </span>

                <span class="experience-date">
                  {item.date}
                </span>

                <span
                  class="plus"
                  aria-hidden="true"
                >
                  +
                </span>

              </button>

              <div class="experience-detail">

                <p>
                  {item.detail}
                </p>

              </div>

            </article>

          ))}

        </div>

      </div>

    </section>

    <!-- PROJECTS -->

    <section
      class="section section-light"
      id="projects"
    >

      <div class="container">

        <div class="section-heading reveal">

          <div class="eyebrow">
            Projects
          </div>

          <h2>
            Selected work.
          </h2>

        </div>

        <div class="projects">

          {projects.map((project) => (

            <article class="project reveal">

              <div class="project-number">
