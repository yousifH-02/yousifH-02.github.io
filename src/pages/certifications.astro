---
import Layout from '../layouts/Layout.astro';
const certificates=[{name:'The Complete SQL Bootcamp',issuer:'Udemy',date:'June 2025',path:'SQL-UdemyCertif.pdf'},{name:'Mastercard Cybersecurity Job Simulation',issuer:'Forage',date:'September 2025',path:'mastercard-cybersec-certif.pdf'},{name:'Telstra Cybersecurity Job Simulation',issuer:'Forage',date:'2025',path:'TelstraCertif.pdf'}];
---
<Layout title="Learning & Certifications — Yousif Husni"><section class="container learning"><p class="eyebrow">ALWAYS LEARNING</p><h1>Keep getting<br/><span>better.</span></h1><p class="lead">The coursework, practice, and small milestones behind the work.</p><div class="education-cards"><article><span class="eyebrow">IN PROGRESS / MAY 2027 EXPECTED</span><h2>University of Houston</h2><p>B.S. in Computer Science</p></article><article><span class="eyebrow">COMPLETED / MAY 2024</span><h2>Wharton County Junior College</h2><p>A.S. in Computer Science</p></article></div><h2 class="cert-title">A few milestones.</h2><div>{certificates.map((c,i)=><a class="certificate" href={`/certifications/${c.path}`} target="_blank" rel="noopener noreferrer"><span class="eyebrow">0{i+1}</span><div><h3>{c.name}</h3><p>{c.issuer} / {c.date}</p></div><span>View certificate ↗</span></a>)}</div></section></Layout>
<style>.learning{padding:70px 0}.learning h1{font-size:clamp(66px,9vw,115px);margin-top:35px}.lead{font-size:20px;line-height:1.6;color:var(--muted);max-width:520px;margin:30px 0 50px}.education-cards{display:grid;grid-template-columns:1fr 1fr;gap:24px}.education-cards article{background:#1b161a;border:1px solid var(--line);padding:30px;border-radius:12px}.education-cards h2{font-size:28px;line-height:1.2}.education-cards p{color:var(--muted);font-size:15px}.cert-title{margin:65px 0 30px;font-size:36px}.certificate{display:grid;grid-template-columns:45px 1fr auto;gap:25px;padding:30px 0;border-top:1px solid var(--line);align-items:center}.certificate:hover h3{color:var(--accent)}.certificate h3{font-weight:400;font-size:22px;margin:0 0 10px}.certificate p{font-size:13px;color:var(--muted);margin:0}.certificate>span:last-child{font-size:12px;color:var(--accent)}@media(max-width:650px){.education-cards{grid-template-columns:1fr}.certificate{grid-template-columns:30px 1fr;gap:15px}.certificate>span:last-child{grid-column:2}.certificate h3{font-size:20px}.learning{padding-top:40px}}</style>
